<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <title>Vertex</title>
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3E%3Cpath d='M1 2h3l4 9 4-9h3L9 14H7z' fill='%236fd3a8'/%3E%3C/svg%3E" />
    <style>
        :root { --bg: #14171f; --panel: #1d2230; --line: #2c3346; --text: #e8ecf5; --muted: #98a2b8; --accent: #6fd3a8; --warn: #f2b84b; --bad: #f2716b; --said: #8fb8ff; }
        * { box-sizing: border-box; }
        body { margin: 0; font-family: system-ui, "Segoe UI", sans-serif; background: var(--bg); color: var(--text); }
        header { display: flex; align-items: center; gap: 12px; padding: 14px 20px; border-bottom: 1px solid var(--line); }
        header h1 { margin: 0; font-size: 22px; letter-spacing: .5px; }
        header .status { color: var(--muted); }
        main { display: grid; grid-template-columns: 430px 1fr; gap: 16px; padding: 16px 20px; }
        @@media (max-width: 860px) { main { grid-template-columns: 1fr; } }
        section { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 14px; }
        h2 { font-size: 15px; margin: 0 0 10px; color: var(--muted); text-transform: uppercase; letter-spacing: .8px; }
        label { display: block; font-size: 13px; color: var(--muted); margin: 8px 0 3px; }
        input, select, textarea { width: 100%; background: #121620; color: var(--text); border: 1px solid var(--line); border-radius: 6px; padding: 7px 9px; font: inherit; }
        textarea { min-height: 90px; resize: vertical; }
        button { background: var(--accent); color: #0d1912; border: 0; border-radius: 6px; padding: 8px 14px; font-weight: 600; cursor: pointer; }
        button.secondary { background: #2c3346; color: var(--text); }
        button:disabled { opacity: .5; cursor: default; }
        .row { display: flex; gap: 8px; align-items: center; }
        .row > * { flex: 1; }
        .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 8px; margin-bottom: 12px; }
        .stat { background: #121620; border-radius: 8px; padding: 8px 10px; }
        .stat b { display: block; font-size: 18px; }
        .stat span { font-size: 12px; color: var(--muted); }
        .log { height: 52vh; overflow-y: auto; font-size: 14px; line-height: 1.45; display: flex; flex-direction: column-reverse; }
        .log div { padding: 2px 0; border-bottom: 1px solid #222838; }
        .t { color: var(--muted); font-size: 12px; margin-right: 6px; }
        .Heard { color: var(--text); } .Said { color: var(--said); } .Tool { color: var(--accent); } .Error { color: var(--bad); } .System { color: var(--muted); } .Chat { color: #d7c8ff; }
        .code { font-size: 26px; font-weight: 700; letter-spacing: 3px; color: var(--warn); }
        .hint { font-size: 12px; color: var(--muted); }
        .tabs { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 12px; }
        .tab { background: transparent; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-weight: 600; }
        .tab:hover { color: var(--text); border-color: var(--muted); }
        .tab.on { background: var(--accent); color: #0d1912; border-color: var(--accent); }
        h3 { font-size: 12px; margin: 20px 0 2px; padding-top: 12px; border-top: 1px solid var(--line); color: var(--accent); text-transform: uppercase; letter-spacing: .8px; }
        .check { display: flex; gap: 10px; align-items: flex-start; margin: 10px 0; font-size: 14px; color: var(--text); cursor: pointer; }
        .check input { width: auto; flex: none; margin-top: 3px; }
        .check b { display: block; font-weight: 600; }
        .check small { display: block; color: var(--muted); font-size: 12px; line-height: 1.4; margin-top: 2px; font-weight: 400; }
        .person { padding: 8px 0; border-bottom: 1px solid #222838; }
        .person strong { flex: 1; }
        .person .hint { display: block; margin-top: 3px; }
    </style>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
