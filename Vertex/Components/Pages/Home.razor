@page "/"
@inject VertexHost Host
@implements IDisposable

<header>
    <h1>Vertex</h1>
    <span class="status">@Host.Status</span>
</header>

<main>
    <div>
        <section>
            <h2>Vertex</h2>
            <label>Brain (language model)</label>
            <select @bind="Host.Settings.Model" disabled="@Busy">
                @if (Host.Models.Count == 0) { <option value="@Host.Settings.Model">@(string.IsNullOrEmpty(Host.Settings.Model) ? "(loads on start)" : Host.Settings.Model)</option> }
                @foreach (var m in Host.Models) { <option value="@m" selected="@(m == Host.Settings.Model)">@m</option> }
            </select>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.Reachy" disabled="@Busy" /> Reachy Mini (Vertex's body at home)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.Minecraft" disabled="@Busy" /> Join Minecraft on start</label>
            <div class="row" style="margin-top:12px">
                @if (Host.State == HostState.Idle)
                {
                    <button @onclick="Host.StartAsync">Start Vertex</button>
                }
                else
                {
                    <button class="secondary" @onclick="Host.StopAsync" disabled="@(Host.State != HostState.Playing)">Stop Vertex</button>
                }
            </div>
        </section>

        <section style="margin-top:16px">
            <h2>Reachy Mini</h2>
            <label>Robot address</label>
            <input @bind="Host.Settings.ReachyHost" disabled="@Host.RobotConnected" />
            <label>Who talks to it (blank: "someone in the room")</label>
            <input @bind="Host.Settings.ReachySpeaker" disabled="@Host.RobotConnected" placeholder="e.g. Aubri" />
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyAnswersEverything" disabled="@Host.RobotConnected" /> Answer everything said near the robot (off: say "Vertex" to start talking)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyRecognizeVoices" disabled="@Host.RobotConnected" /> Tell people apart by their voice (people Vertex has been introduced to are called by name; strangers are "Guest 1", "Guest 2")</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyFaces" disabled="@Host.RobotConnected" /> Recognise people by their face through the robot's camera (learns the face of anyone who is introduced, knows who is in the room, says hi to someone it knows who walks in after a long absence; faces stay on this PC)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyFaceSpeaker" disabled="@Host.RobotConnected" /> Turn to face whoever is talking to the robot (uses the direction the voice comes from, and the face that matches it; turns back to the front after a quiet spell)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyFollowFaces" disabled="@Host.RobotConnected" /> Keep looking at the person talking to the robot as they move (needs faces on)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyStreamSpeech" disabled="@Host.RobotConnected" /> Stream the robot's speech live over the connection (starts at once, no upload wait; the sound is Opus compressed instead of the uploaded WAV; off: upload each sentence first)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachyLiveWords" disabled="@Host.RobotConnected" /> Show my words as I say them (a streaming recogniser types along while I talk; the finished sentence is still transcribed by the more accurate one; uses about 1.2 GB of GPU memory)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachySmartTurn" disabled="@Host.RobotConnected" /> Know when I have finished talking (answers a finished sentence sooner and waits while I am still thinking; off: always waits half a second)</label>
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.ReachySaveHeard" disabled="@Host.RobotConnected" /> Keep what the robot hears (audio, words, who) in <code>@Host.HeardFolder</code> to measure listening on this household's voices. Stays on this PC.</label>
            @if (Host.State == HostState.Playing)
            {
                <div class="row" style="margin-top:12px">
                    @if (Host.RobotConnected)
                    {
                        <button class="secondary" @onclick="Host.DisconnectRobotAsync">Park the robot</button>
                    }
                    else
                    {
                        <button @onclick="Host.ConnectRobotAsync">Wake the robot</button>
                    }
                </div>
            }
        </section>

        <section style="margin-top:16px">
            <h2>People</h2>
            <p class="hint">Vertex knows people by their voice and their face. Everything about a person stays on this PC. Someone who has been introduced is kept until you remove them; a stranger nobody introduces is a guest and is forgotten after 24 hours.</p>
            @if (Host.InView.Length > 0)
            {
                <p class="hint">Camera sees now: @Host.InView</p>
            }
            @if (Host.KnownPeople.Count == 0)
            {
                <p class="hint">Nobody yet. Introduce yourself out loud while the robot can see you: "Vertex, I'm Nikki".</p>
            }
            @foreach (var person in Host.KnownPeople)
            {
                RenameTo.TryAdd(person.Name, "");
                <div class="row" style="margin-top:6px">
                    <strong style="min-width:120px">@person.Name</strong>
                    <span class="hint">@Held(person) - @(person.IsGuest ? $"a stranger, forgotten {person.ForgottenAtUtc?.ToLocalTime():MMM d h:mm tt}" : "introduced, kept until removed")@(person.LastSeenUtc is { } seen ? $"; last seen {seen.ToLocalTime():MMM d h:mm tt}" : "")</span>
                    @if (person.IsGuest)
                    {
                        <input style="max-width:140px" placeholder="their name" @bind="RenameTo[person.Name]" />
                        <button class="secondary" @onclick="() => Host.NamePerson(person.Name, RenameTo[person.Name])">Name them</button>
                    }
                    <button class="secondary" @onclick="() => Host.ForgetPerson(person.Name)">Forget</button>
                </div>
            }
            @if (Host.KnownPeople.Count > 0)
            {
                <div class="row" style="margin-top:10px">
                    <button class="secondary" @onclick="() => Host.ForgetGuests()" disabled="@(!Host.KnownPeople.Any(p => p.IsGuest))">Forget all guests</button>
                    @if (!ConfirmForgetAll)
                    {
                        <button class="secondary" @onclick="() => ConfirmForgetAll = true">Forget everyone...</button>
                    }
                    else
                    {
                        <span class="hint">Remove every voice and face, introduced people too?</span>
                        <button @onclick="ForgetEveryone">Yes, forget everyone</button>
                        <button class="secondary" @onclick="() => ConfirmForgetAll = false">Cancel</button>
                    }
                </div>
            }
            <label style="margin-top:12px">Add a person: their name</label>
            <div class="row">
                <input @bind="NewVoice" placeholder="e.g. Nikki" />
                <button @onclick="LearnVoice" disabled="@(string.IsNullOrWhiteSpace(NewVoice))">Learn their voice and face</button>
            </div>
            <p class="hint">Then have them say a few sentences in front of the robot: the next new voice and face it notices are theirs.</p>
            @if (VoiceMessage != "") { <p class="hint">@VoiceMessage</p> }
        </section>

        <section style="margin-top:16px">
            <h2>Minecraft</h2>
            <label>Server</label>
            <div class="row">
                <input @bind="Host.Settings.Server" disabled="@InGameOrBusy" />
                <input type="number" style="max-width:90px" @bind="Host.Settings.Port" disabled="@InGameOrBusy" />
            </div>
            <label>Account</label>
            <select @bind="AccountMode" disabled="@InGameOrBusy">
                <option value="microsoft">Microsoft account (signed in)</option>
                <option value="offline">Offline name (local test servers)</option>
            </select>
            @if (AccountMode == "offline")
            {
                <label>Offline name</label>
                <input @bind="Host.Settings.OfflineName" disabled="@InGameOrBusy" />
            }
            <label><input type="checkbox" style="width:auto" @bind="Host.Settings.Voice" disabled="@InGameOrBusy" /> Voice chat (Simple Voice Chat)</label>
            @if (Host.State == HostState.Playing)
            {
                <div class="row" style="margin-top:12px">
                    @if (Host.InGame)
                    {
                        <button class="secondary" @onclick="Host.LeaveGameAsync">Leave the game</button>
                        <button class="secondary" @onclick="Host.StopTask">Stop task</button>
                    }
                    else
                    {
                        <button @onclick="Host.JoinGameAsync">Join the game</button>
                    }
                </div>
            }
            @if (Host.SignInPrompt is { } p)
            {
                <p>Sign in at <a href="@p.DirectLink" target="_blank">microsoft.com/link</a> with the code</p>
                <div class="code">@p.UserCode</div>
            }
        </section>

        <section style="margin-top:16px">
            <h2>Character</h2>
            <select value="@Host.Settings.Character" @onchange="OnCharacter">
                @foreach (var c in Characters) { <option value="@c.Name">@c.Name</option> }
            </select>
            @if (Editing is { } e)
            {
                <label>Personality</label>
                <textarea @bind="e.Persona"></textarea>
                <label>Voice</label>
                <select @bind="e.Voice">
                    @foreach (var v in Vertex.AI.VertexAi.Voices) { <option value="@v">@v.Replace("kokoro:", "")</option> }
                </select>
                <label>Chatty @e.Style.Chattiness.ToString("0.0") / Brave @e.Style.Bravery.ToString("0.0") / Helpful @e.Style.Helpfulness.ToString("0.0") / Playful @e.Style.Playfulness.ToString("0.0")</label>
                <div class="row">
                    <input type="range" min="0" max="1" step="0.1" @bind="e.Style.Chattiness" @bind:event="oninput" title="Chatty" />
                    <input type="range" min="0" max="1" step="0.1" @bind="e.Style.Bravery" @bind:event="oninput" title="Brave" />
                </div>
                <div class="row">
                    <input type="range" min="0" max="1" step="0.1" @bind="e.Style.Helpfulness" @bind:event="oninput" title="Helpful" />
                    <input type="range" min="0" max="1" step="0.1" @bind="e.Style.Playfulness" @bind:event="oninput" title="Playful" />
                </div>
                <div class="row" style="margin-top:10px">
                    <button class="secondary" @onclick="SaveCharacter">Save character</button>
                </div>
                <label>New character name</label>
                <div class="row">
                    <input @bind="NewName" placeholder="e.g. Sparkle" />
                    <button class="secondary" style="flex:0" @onclick="NewCharacter">Add</button>
                </div>
            }
        </section>
    </div>

    <div>
        <section>
            <div class="stats">
                <div class="stat"><b>@(Host.Client?.Health / 2 ?? 0)</b><span>hearts</span></div>
                <div class="stat"><b>@(Host.Client?.Food / 2 ?? 0)</b><span>food</span></div>
                <div class="stat"><b>@Position</b><span>position</span></div>
                <div class="stat"><b>@(Host.Brain?.Tasks.Current ?? "idle")</b><span>doing</span></div>
                <div class="stat"><b>@(Host.Voice?.IsConnected == true ? "on" : "off")</b><span>voice</span></div>
            </div>
            <div class="row" style="margin-bottom:10px">
                <input @bind="Message" @bind:event="oninput" @onkeydown="OnKey" placeholder="Tell Vertex something, e.g. hi Vertex, how are you?" disabled="@(Host.State != HostState.Playing)" />
                <button style="flex:0" @onclick="Send" disabled="@(Host.State != HostState.Playing)">Say</button>
            </div>
            @if (Host.VoiceFrom.Length > 0)
            {
                <div class="System" style="margin-bottom:6px"><span class="t">voice</span>@(Host.VoiceSpeakingNow ? "from" : "was from") the robot's @Host.VoiceFrom</div>
            }
            @if (Host.LiveCaption.Length > 0)
            {
                <div class="Heard" style="margin-bottom:8px"><span class="t">hearing</span>@Host.LiveCaption …</div>
            }
            <div class="log">
                @foreach (var line in Host.Lines.AsEnumerable().Reverse())
                {
                    <div class="@line.Kind"><span class="t">@line.Time.ToString("HH:mm:ss")</span>@Label(line.Kind)@line.Text</div>
                }
            </div>
            <p class="hint">Heard = what Vertex heard (voice or chat). Said = what it answered. Tool = what it did.</p>
        </section>
    </div>
</main>

@code {
    private string Message = "";
    private string NewName = "";
    private Character? Editing;
    private IReadOnlyList<Character> Characters = [];
    private Timer? _timer;
    private string NewVoice = "";
    private string VoiceMessage = "";
    private bool ConfirmForgetAll;

    private static string Held(Vertex.People.PersonRecord p) => p.HasVoice && p.HasFace ? "voice and face" : p.HasVoice ? "voice only" : "face only";

    private void ForgetEveryone()
    {
        Host.ForgetEveryone();
        ConfirmForgetAll = false;
    }
    /// <summary>The name typed for each guest, by guest name.</summary>
    private Dictionary<string, string> RenameTo { get; } = new();

    private void LearnVoice()
    {
        VoiceMessage = Host.LearnVoice(NewVoice.Trim());
        NewVoice = "";
    }

    private bool Busy => Host.State != HostState.Idle;
    private bool InGameOrBusy => Host.InGame || Host.State is HostState.Starting or HostState.Stopping;

    private string AccountMode
    {
        get => string.IsNullOrWhiteSpace(Host.Settings.Account) ? "offline" : "microsoft";
        set => Host.Settings.Account = value == "offline" ? "" : "default";
    }

    private string Position => Host.Client is { } c ? $"{c.Position.X:0} {c.Position.Y:0} {c.Position.Z:0}" : "-";

    private static string Label(LineKind kind) => kind switch
    {
        LineKind.Heard => "heard: ", LineKind.Said => "said: ", LineKind.Tool => "", LineKind.Error => "error: ", _ => "",
    };

    protected override void OnInitialized()
    {
        Characters = Host.Characters.All();
        Editing = Host.Characters.Find(Host.Settings.Character) ?? Characters.FirstOrDefault();
        Host.Changed += OnChanged;
        // Health, position and the current task change without an event: refresh twice a second.
        _timer = new Timer(_ => InvokeAsync(StateHasChanged), null, 500, 500);
    }

    private void OnChanged() => InvokeAsync(StateHasChanged);

    private void OnCharacter(ChangeEventArgs e)
    {
        var name = e.Value?.ToString() ?? "Vertex";
        Host.SwitchCharacter(name);
        Editing = Host.Characters.Find(name);
    }

    private void SaveCharacter()
    {
        if (Editing == null) return;
        Host.Characters.Save(Editing);
        if (Host.Companion != null && Host.Companion.Character.Name == Editing.Name) Host.SwitchCharacter(Editing.Name);
        Characters = Host.Characters.All();
    }

    private void NewCharacter()
    {
        if (string.IsNullOrWhiteSpace(NewName)) return;
        var c = new Character { Name = NewName.Trim(), Persona = $"You are {NewName.Trim()}, a friendly Minecraft companion.", Voice = "kokoro:af_heart" };
        Host.Characters.Save(c);
        Characters = Host.Characters.All();
        Editing = c;
        NewName = "";
    }

    private void Send()
    {
        Host.Tell(Message);
        Message = "";
    }

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") Send();
    }

    public void Dispose()
    {
        Host.Changed -= OnChanged;
        _timer?.Dispose();
    }
}
