<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<!-- A Windows app: the tray (the default) starts with Windows without a console window. -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Version>0.1.0</Version>
		<Description>Vertex: an AI that plays Minecraft with you.</Description>
	</PropertyGroup>
	<ItemGroup>
		<!-- 1.2.0-local.3 (local feed, 2026-10-14): Parakeet TDT speech to text and speaker identification (AiSpeakerEngine,
		     SpeakerRegistry), on SpawnDev.ILGPU.ML 5.3.9-local.2 (nine library fixes; fp16-stored Parakeet weights are real from here). Before that:
		     1.1.2 on ML 5.3.7 (GPU memory reclaimed before the driver spills, outputs that do not leak, interrupted replies that
		     do not poison the next one). nuget.org release pending TJ's sign-off. -->
		<PackageReference Include="SpawnDev.AI.Server" Version="1.2.0-local.3" />
		<!-- The Reachy Mini (Vertex's body out of the game): daemon REST API + WebRTC microphone. -->
		<PackageReference Include="SpawnDev.Reachy" Version="0.1.0-preview.4" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Minecraft\SpawnDev.Minecraft.csproj" />
		<ProjectReference Include="..\SpawnDev.Minecraft.VoiceChat\SpawnDev.Minecraft.VoiceChat.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Vertex.Tests" />
		<!-- Windows Forms is only the tray; keep its names (Timer, Control, Application...) out of every other file. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>
	<ItemGroup>
		<!-- The block dump mod (tools/ModDump builds it): run with a server's modpack to learn its modded blocks. -->
		<!-- Silero VAD for the robot's open microphone (Reachy/PROVENANCE.md). -->
		<EmbeddedResource Include="Reachy\silero_vad.onnx" LogicalName="Vertex.Reachy.silero_vad.onnx" />
		<EmbeddedResource Include="Mods\vertex-moddump.jar" LogicalName="Vertex.Mods.vertex-moddump.jar" />
		<!-- The trained fight-or-flight policy (Vertex.Tests ReflexTraining), only once it beat the hand-written rule. -->
		<EmbeddedResource Include="Brain\reflex-policy.bin" LogicalName="Vertex.Brain.reflex-policy.bin" Condition="Exists('Brain\reflex-policy.bin')" />
	</ItemGroup>
</Project>
