<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<!-- A Windows app: the tray (the default) starts with Windows without a console window. -->
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<UseWindowsForms>true</UseWindowsForms>
		<Version>0.1.0</Version>
		<Description>Vertex: an AI that plays Minecraft with you.</Description>
	</PropertyGroup>
	<ItemGroup>
		<!-- 1.2.0-local.4 (local feed, 2026-10-14): Parakeet TDT speech to text, speaker identification (AiSpeakerEngine,
		     SpeakerRegistry) and end-of-turn detection (AiTurnEngine, Smart Turn v3.2), on SpawnDev.ILGPU.ML 5.3.9-local.3 (library fixes; fp16-stored
		     Parakeet weights are real from here). Before that:
		     1.1.2 on ML 5.3.7 (GPU memory reclaimed before the driver spills, outputs that do not leak, interrupted replies that
		     do not poison the next one). nuget.org release pending TJ's sign-off. -->
		<PackageReference Include="SpawnDev.AI.Server" Version="1.2.0-local.4" />
		<!-- The Reachy Mini (Vertex's body out of the game): daemon REST API + WebRTC microphone. -->
		<PackageReference Include="SpawnDev.Reachy" Version="0.1.0-preview.4" />
	</ItemGroup>
	<ItemGroup>
		<ProjectReference Include="..\SpawnDev.Minecraft\SpawnDev.Minecraft.csproj" />
		<ProjectReference Include="..\SpawnDev.Minecraft.VoiceChat\SpawnDev.Minecraft.VoiceChat.csproj" />
	</ItemGroup>
	<ItemGroup>
		<InternalsVisibleTo Include="Vertex.Tests" />
		<!-- Windows Forms is only the tray; keep its names (Timer, Control, Application...) out of every other file. -->
		<Using Remove="System.Windows.Forms" />
		<Using Remove="System.Drawing" />
	</ItemGroup>
	<ItemGroup>
		<!-- The block dump mod (tools/ModDump builds it): run with a server's modpack to learn its modded blocks. -->
		<!-- Silero VAD for the robot's open microphone (Reachy/PROVENANCE.md). -->
		<EmbeddedResource Include="Reachy\silero_vad.onnx" LogicalName="Vertex.Reachy.silero_vad.onnx" />
		<EmbeddedResource Include="Mods\vertex-moddump.jar" LogicalName="Vertex.Mods.vertex-moddump.jar" />
		<!-- The trained fight-or-flight policy (Vertex.Tests ReflexTraining), only once it beat the hand-written rule. -->
		<EmbeddedResource Include="Brain\reflex-policy.bin" LogicalName="Vertex.Brain.reflex-policy.bin" Condition="Exists('Brain\reflex-policy.bin')" />
	</ItemGroup>

	<!-- WORKAROUND (SDK defect, 2026-10-14): the package Microsoft.AspNetCore.App.Internal.Assets adds _framework/blazor.web.js (and blazor.server.js) to a project only when
	     OutputType == 'Exe'. Vertex is a WinExe (the tray starts with Windows without a console window), so the control panel rendered but nothing on it responded: GET
	     /_framework/blazor.web.js was a 404 from the build output AND from a publish. This target is that package's own target (10.0.12, build/Microsoft.AspNetCore.App.Internal.Assets.targets)
	     with the condition widened to WinExe, run right after it. Remove it when the package accepts WinExe. -->
	<Target Name="_VertexAddBlazorFrameworkStaticWebAssets" AfterTargets="_AddBlazorFrameworkStaticWebAssets" Condition="'$(OutputType)' == 'WinExe' AND '$(UsingMicrosoftNETSdkWeb)' == 'true'">
		<ItemGroup>
			<_VertexFrameworkCandidate Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.web.js" RelativePath="_framework/blazor.web.js" />
			<_VertexFrameworkCandidate Include="$(BlazorFrameworkStaticWebAssetRoot)\blazor.server.js" RelativePath="_framework/blazor.server.js" />
			<_VertexFrameworkMissing Include="@(_VertexFrameworkCandidate)" Condition="!EXISTS('%(Identity)')" />
			<_VertexFrameworkCandidate Remove="@(_VertexFrameworkMissing)" />
		</ItemGroup>
		<Message Importance="High" Condition="'@(_VertexFrameworkMissing->Count())' != '0'" Text="Framework asset '%(_VertexFrameworkMissing.Identity)' could not be found and won't be included in the project." />
		<DefineStaticWebAssets Condition="'@(_VertexFrameworkCandidate->Count())' != '0'" CandidateAssets="@(_VertexFrameworkCandidate)" ContentRoot="$(BlazorFrameworkStaticWebAssetRoot)"
			SourceId="$(PackageId)" SourceType="Discovered" AssetKind="All" AssetMode="CurrentProject" AssetRole="Primary" FingerprintCandidates="true" BasePath="$(StaticWebAssetBasePath)">
			<Output TaskParameter="Assets" ItemName="_VertexFrameworkStaticWebAsset" />
		</DefineStaticWebAssets>
		<DefineStaticWebAssetEndpoints Condition="'@(_VertexFrameworkStaticWebAsset)' != ''" CandidateAssets="@(_VertexFrameworkStaticWebAsset)" ExistingEndpoints="" ContentTypeMappings="@(StaticWebAssetContentTypeMapping)">
			<Output TaskParameter="Endpoints" ItemName="_VertexFrameworkEndpoint" />
		</DefineStaticWebAssetEndpoints>
		<ItemGroup>
			<StaticWebAsset Include="@(_VertexFrameworkStaticWebAsset)" />
			<StaticWebAssetEndpoint Include="@(_VertexFrameworkEndpoint)" />
		</ItemGroup>
	</Target>
</Project>
